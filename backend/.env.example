# Copy to .env and fill in what you need. All values are optional.

# --- LLM for tailored cover letters (OpenAI-compatible) ---
# Leave blank to use the built-in template generator.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint (Azure, local, etc.)
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- CORS (comma separated). "*" allows all origins. ---
CORS_ORIGINS=*

# --- Optional automated browser submission ---
# Keep false. Automating a logged-in LinkedIn account can violate the
# LinkedIn User Agreement. When false the app produces a reviewed,
# approval-gated package for you to finish in your own session.
ENABLE_BROWSER_SUBMIT=false
